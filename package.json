{
  "name": "dms",
  "version": "0.1.0",
  "private": true,
  "description": "Bilingual dormitory management system (21 rooms, 3 floors, Thailand)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css}\" \"*.{ts,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "tsx scripts/db-push.ts",
