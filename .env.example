# Copy to .env.local and fill in from your Supabase project:
#   Supabase dashboard -> Project Settings -> API
#
# .env.local is gitignored. Never commit real values.

# --- Public (safe to expose to the browser) ---------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Server only ------------------------------------------------------------
# Bypasses Row Level Security. Used by scripts/ and src/lib/supabase/admin.ts,
# which imports 'server-only' so a client bundle referencing it fails the build.
# Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Postgres connection, used only by `npm run db:push` and `npm run seed`.
# Supabase dashboard -> Project Settings -> Database -> Connection string (URI).
# Use the pooler URI on port 6543 if your network blocks 5432.
SUPABASE_DB_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# --- Optional ---------------------------------------------------------------
# Public origin, used for auth redirect URLs. Vercel sets this per deployment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
